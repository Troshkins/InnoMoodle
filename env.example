# =============================================================================
# InnoMoodle Environment Configuration
# =============================================================================
# Copy this file to .env and update the values according to your environment
# cp env.example .env

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database host (use 'db' for Docker Compose, 'localhost' for local development)
DB_HOST=localhost

# Database port
DB_PORT=5432

# Database username
DB_USER=postgres

# Database password (CHANGE THIS IN PRODUCTION!)
DB_PASSWORD=your_secure_password

# Database name
DB_NAME=innomoodle

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port (default: 8080)
SERVER_PORT=8080

# Server environment (development, staging, production)
NODE_ENV=development

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================

# JWT secret key (CHANGE THIS IN PRODUCTION!)
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT token expiration time (default: 72 hours)
JWT_EXPIRATION=72h

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log format (json, text)
LOG_FORMAT=text

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# RATE LIMITING
# =============================================================================

# Rate limit requests per minute (0 = disabled)
RATE_LIMIT_REQUESTS=100

# Rate limit window in minutes
RATE_LIMIT_WINDOW=1

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Maximum file upload size in MB
MAX_FILE_SIZE=10

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# File upload directory
UPLOAD_DIR=./uploads

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# SMTP host
# SMTP_HOST=smtp.gmail.com

# SMTP port
# SMTP_PORT=587

# SMTP username
# SMTP_USERNAME=your_email@gmail.com

# SMTP password
# SMTP_PASSWORD=your_app_password

# From email address
# FROM_EMAIL=noreply@innomoodle.com

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching/sessions)
# =============================================================================

# Redis host
# REDIS_HOST=localhost

# Redis port
# REDIS_PORT=6379

# Redis password
# REDIS_PASSWORD=

# Redis database
# REDIS_DB=0

# =============================================================================
# MONITORING CONFIGURATION (Optional)
# =============================================================================

# Enable metrics endpoint
# ENABLE_METRICS=false

# Metrics port
# METRICS_PORT=9090

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# Enable HTTPS (true/false)
# ENABLE_HTTPS=false

# SSL certificate path
# SSL_CERT_PATH=/path/to/cert.pem

# SSL key path
# SSL_KEY_PATH=/path/to/key.pem

# Trust proxy headers (for load balancers)
# TRUST_PROXY=false

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable debug mode
DEBUG=true

# Enable hot reload (for development)
HOT_RELOAD=true

# Auto-migrate database (for development)
AUTO_MIGRATE=true